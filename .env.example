# Local development only. On Hostinger, set ONLY the INFISICAL_* values; the rest
# are fetched from Infisical (vizion-infrastructure, prod, /platform/portal) at runtime.
PORTAL_API_URL=https://portal-api.vizionai.iamvisioncorp.org

INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=918f6641-7111-4c80-b08a-46321c6b81ab
INFISICAL_ENV=prod
INFISICAL_SECRET_PATH=/platform/portal

# Optional local overrides (any secret found in env wins over Infisical):
# PORTAL_API_KEY=
# PORTAL_SESSION_SECRET=
# PORTAL_OWNER_EMAIL=
# PORTAL_OWNER_PASSWORD=
